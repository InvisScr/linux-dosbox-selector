[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;
Actions=dosboxHere;
X-KDE-MaxNumberOfUrls=1

[Desktop Action dosboxHere]
Name=DOSBox Here
Comment=Pick a DOSBox flavor and run it in this folder
Icon=applications-games
Exec=@INSTALL_DIR@/DosBoxSelector %u
