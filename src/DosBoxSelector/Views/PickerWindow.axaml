<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DosBoxSelector.ViewModels"
        x:Class="DosBoxSelector.Views.PickerWindow"
        x:DataType="vm:PickerViewModel"
        Title="DOSBox Here"
        Width="520" MinWidth="420"
        Height="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16">

    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Run DOSBox in" Opacity="0.7" FontSize="12" />
      <TextBlock Text="{Binding TargetName}" FontSize="18" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding TargetDirectory}" Opacity="0.55" FontSize="11"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TargetDirectory}" />
    </StackPanel>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Flavors}"
             SelectedItem="{Binding SelectedFlavor}"
             DoubleTapped="OnFlavorDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FlavorRow">
          <Grid ColumnDefinitions="*,Auto" Margin="2,4">
            <StackPanel Grid.Column="0" Spacing="1">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                         Opacity="{Binding NameOpacity}" />
              <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding MatchHint}" FontSize="11" FontStyle="Italic"
                         Foreground="{DynamicResource SystemAccentColor}"
                         IsVisible="{Binding HasMatchHint}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="not installed" FontSize="11" Opacity="0.5"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       IsVisible="{Binding !IsAvailable}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0" IsVisible="{Binding HasConfs}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Config files" FontSize="12" Opacity="0.7"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="applied in order — later files win"
                   FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <ListBox Grid.Column="0" MaxHeight="132"
                 ItemsSource="{Binding Confs}"
                 SelectedItem="{Binding SelectedConfEntry}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfEntry">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding OrderLabel}" FontFamily="monospace"
                           FontSize="11" Opacity="0.55" Width="16" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" Margin="0,0,4,0"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding FileName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="11" Opacity="0.5"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Top">
          <Button Content="▲" Click="OnConfUpClick" IsEnabled="{Binding CanMoveUp}"
                  Width="30" ToolTip.Tip="Apply this file earlier" />
          <Button Content="▼" Click="OnConfDownClick" IsEnabled="{Binding CanMoveDown}"
                  Width="30" ToolTip.Tip="Apply this file later" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- The whole command is reachable by scrolling; truncating it would hide which
         config and flags are actually in play, which is the point of showing it. -->
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            CornerRadius="4">
      <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock Text="{Binding CommandPreview}" FontSize="10.5"
                             FontFamily="monospace" TextWrapping="Wrap" Opacity="0.75" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               Foreground="#c0392b" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" />

    <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
      <Button Grid.Column="0" Content="Manage flavors…" Click="OnManageClick" />
      <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
      <Button Grid.Column="3" Content="Launch" Click="OnLaunchClick" MinWidth="90"
              IsDefault="True" IsEnabled="{Binding CanLaunch}"
              Classes="accent" />
    </Grid>

  </Grid>
</Window>
